# Gemini API Key for LLM code review explanation & remediation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# API Server Port & Host
PATCHPILOT_HOST=0.0.0.0
PATCHPILOT_PORT=8000

# Optional: GitHub Personal Access Token to avoid unauthenticated rate limits (60 req/hr -> 5,000 req/hr)
# Never stored or leaked; passed strictly via Authorization header
# GITHUB_TOKEN=your_github_token_here
